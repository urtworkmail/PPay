# Copy to .env at the repo root on the VM and fill in real values.
# This file is read two ways by `docker compose -f docker-compose.prod.yml`:
#   1. ${VAR} substitution inside docker-compose.prod.yml itself (POSTGRES_PASSWORD, SITE_ADDRESS)
#   2. Injected directly into the backend container's environment (everything the app reads)
# Never commit the real .env — it's already in .gitignore.

# --- Domain ---
SITE_ADDRESS=ppay.autruckers.com

# --- Postgres ---
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Backend ---
# Must match POSTGRES_PASSWORD above. Host is "db" (the compose service name),
# port is the container-internal 5432, not the 5433 used for local dev.
DATABASE_URL=postgresql+asyncpg://openpay:change-me-to-a-long-random-string@db:5432/openpay

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production

# Belt-and-suspenders: the frontend and API are same-origin behind Caddy so
# browser requests never trigger CORS, but keep this correct in case anything
# ever calls the API cross-origin (e.g. a merchant's own server-to-server
# integration doesn't need it, but a future admin tool might).
CORS_ORIGINS=https://ppay.autruckers.com
