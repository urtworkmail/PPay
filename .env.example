# Copy this file to .env and adjust as needed for local development.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://openpay:openpay@localhost:5433/openpay
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# --- Outbound email (SMTP) ---
# Leave SMTP_HOST empty to run in console mode: messages are logged instead of
# sent, so local development needs no mail server and no real credentials.
# Never commit real values here — put them in .env, which is gitignored.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=notifications@ppay.silicatelabs.site
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=notifications@ppay.silicatelabs.site
SMTP_FROM_NAME=PPay

# Emailed one-time codes
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5

# --- Rate limiting (in-process; see backend/app/core/rate_limit.py) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SESSION_REQUESTS_PER_MINUTE=300
RATE_LIMIT_IP_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10

# --- Platform status monitor (super-admin owned, not merchant-configurable) ---
STATUS_PROBE_BASE_URL=http://localhost:8000
STATUS_ALERT_EMAIL=silicatelabs@gmail.com
STATUS_CHECK_INTERVAL_SECONDS=60
STATUS_DOWN_RECHECK_SECONDS=10
STATUS_ALERT_REPEAT_MINUTES=10
STATUS_MONITOR_ENABLED=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
